    "url": "https://github.com/Roy-Jin/music-getter.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/Roy-Jin/music-getter/issues"
  }
