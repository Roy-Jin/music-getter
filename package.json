{
  "name": "music-getter",
  "version": "1.2.0",
  "description": "A music resource acquisition tool that supports the Meting API.",
  "author": "Roy-Jin",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "music-getter": "dist/bin/cli.js",
    "mg": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
