{
  "name": "ncmget",
  "version": "0.2.1",
  "description": "A lightweight and powerful cli tool for NetEase Cloud Music Getter.",
  "author": "Roy-Jin",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ncmget": "dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin/cli.js",
    "dev": "tsx watch src/bin/cli.ts",
    "docs:dev": "pnpm -F docs run dev",
    "docs:build": "pnpm -F docs run build",
    "docs:preview": "pnpm -F docs run preview",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ncm",
    "netease",
    "getter",
    "download",
    "cli",
    "tool"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roy-Jin/ncmget.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/Roy-Jin/ncmget/issues"
  },
  "homepage": "https://ncmget.pages.dev"
}
